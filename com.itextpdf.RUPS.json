{
    "id": "com.itextpdf.RUPS",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "24.08",
    "command": "rups",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.openjdk17"
    ],
    "finish-args": [
        "--env=PATH=/app/jre/bin:/app/bin:/usr/bin",
        "--env=JAVA_HOME=/app/jre",
        "--env=JAVA=/app/jre/bin/java",
        "--env=JAVA_TOOL_OPTIONS=-Djava.io.tmpdir=/var/tmp -Dswing.systemlaf=com.sun.java.swing.plaf.gtk.GTKLookAndFeel",
        "--env=TMPDIR=/var/tmp",
        "--filesystem=/var/tmp",
        "--device=dri",
        "--share=ipc",
        "--socket=x11",
        "--socket=pulseaudio",
        "--filesystem=home",
        "--filesystem=xdg-config/gtk-3.0:ro",
        "--persist=.java"
    ],
    "modules": [
        {
            "name": "xgetres",
            "buildsystem": "simple",
            "build-commands": [
                "make",
                "make install PREFIX=/app"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/tamirzb/xgetres",
                    "tag": "1.0"
                }
            ]
        },
        {
            "name": "rups",
            "buildsystem": "simple",
            "build-options": {
                "build-args": [
                    "--share=network"
                ],
                "prepend-path": "/usr/lib/sdk/openjdk17/bin"
            },
            "build-commands": [
                "/usr/lib/sdk/openjdk17/install.sh",
                "mvn -V -B -D skipTests=true verify",
                "install -d /app/rups/",
                "ls -lA target",
                "install -Dm 644 -t /app/rups/ target/itext-rups-*.jar",
                "install -Dm 755 rups.sh /app/bin/rups"
            ],
            "post-install": [
                "for jar in /app/rups/itext-rups-*.jar; do mkdir -p rups && bsdtar -C rups -xf \"$jar\" 'com/itextpdf/rups/logo.png'; done",
                "desktop-file-install --dir=/app/share/applications com.itextpdf.RUPS.desktop",
                "install -Dm644 com.itextpdf.RUPS.metainfo.xml /app/share/metainfo/com.itextpdf.RUPS.metainfo.xml",
                "ffmpeg -i rups/com/itextpdf/rups/logo.png -filter:v 'scale=512:512:force_original_aspect_ratio=decrease,pad=512:512:-1:-1:color=0xFFFFFF00' -frames:v 1 -update 1 rups512x512.png",
                "install -Dm 644 rups512x512.png ${FLATPAK_DEST}/share/icons/hicolor/512x512/apps/com.itextpdf.RUPS.png"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/itext/i7j-rups.git",
                    "branch": "develop"
                },
                {
                    "type": "patch",
                    "paths": [
                        "patches/0001-build-Allow-skipping-tests.patch"
                    ],
                    "use-git": true
                },
                {
                    "type": "file",
                    "path": "com.itextpdf.RUPS.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "com.itextpdf.RUPS.desktop"
                },
                {
                    "type": "file",
                    "path": "rups.sh"
                }
            ]
        }
    ]
}
